msgid "ElevenLabs is unavailable."
msgstr "ElevenLabs ni na voljo."

msgid "Could not find the ElevenLabs driver"
msgstr "Gonilnika ElevenLabs ni mogoče najti"

msgid "No API key found"
msgstr "Ključa API ni mogoče najti"

msgid "Fetching usage"
msgstr "Pridobivanje porabe"

msgid "Could not fetch usage, see the NVDA log"
msgstr "Porabe ni bilo mogoče pridobiti, oglejte si dnevnik NVDA"

msgid "Unexpected response from ElevenLabs"
msgstr "Nepričakovan odziv storitve ElevenLabs"

msgid "Credits used: {used} of {limit} ({percent}%)."
msgstr "Porabljeni krediti: {used} od {limit} ({percent} %)."

