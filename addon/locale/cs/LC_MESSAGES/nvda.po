msgid "Fetching usage"
msgstr "Načítání využití"

msgid "Could not fetch usage, see the NVDA log"
msgstr "Využití se nepodařilo načíst, viz protokol NVDA"

msgid "Unexpected response from ElevenLabs"
msgstr "Neočekávaná odpověď od ElevenLabs"

msgid "Credits used: {used} of {limit} ({percent}%)."
msgstr "Využité kredity: {used} z {limit} ({percent}%)."

