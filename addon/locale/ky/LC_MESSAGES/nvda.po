msgstr "Үндөр жана моделдер текшерилүүдө"

msgid "A check is already running"
msgstr "Текшерүү буга чейин эле жүрүүдө"

msgid "Voices and models will be checked next time you select ElevenLabs"
msgstr "Үндөр жана моделдер кийинки жолу ElevenLabs тандаганыңызда текшерилет"

msgid "Could not update the ElevenLabs settings file"
msgstr "ElevenLabs жөндөөлөр файлын жаңыртуу мүмкүн болгон жок"

