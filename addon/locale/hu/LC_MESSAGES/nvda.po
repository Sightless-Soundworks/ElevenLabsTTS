msgstr "Nem található API-kulcs"

msgid "Fetching usage"
msgstr "Felhasználás lekérése"

msgid "Could not fetch usage, see the NVDA log"
msgstr "A felhasználás nem kérhető le, lásd az NVDA naplóját"

msgid "Unexpected response from ElevenLabs"
msgstr "Váratlan válasz az ElevenLabstól"

msgid "Credits used: {used} of {limit} ({percent}%)."
msgstr "Felhasznált kreditek: {used}, összesen {limit} ({percent}%)."

