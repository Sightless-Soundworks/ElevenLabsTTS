msgid "ElevenLabs is unavailable."
msgstr "ElevenLabs n'est pas disponible."

msgid "Could not find the ElevenLabs driver"
msgstr "Impossible de trouver le pilote ElevenLabs"

msgid "No API key found"
msgstr "Aucune clé API trouvée"

msgid "Fetching usage"
msgstr "Récupération de la consommation"

msgid "Could not fetch usage, see the NVDA log"
msgstr "Impossible de récupérer la consommation, consultez le journal de NVDA"

msgid "Unexpected response from ElevenLabs"
msgstr "Réponse inattendue d'ElevenLabs"

msgid "Credits used: {used} of {limit} ({percent}%)."
msgstr "Crédits utilisés : {used} sur {limit} ({percent} %)."

