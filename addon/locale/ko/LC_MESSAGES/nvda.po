msgstr "ElevenLabs 드라이버를 찾을 수 없습니다"

msgid "No API key found"
msgstr "API 키를 찾을 수 없습니다"

msgid "Fetching usage"
msgstr "사용량을 가져오는 중"

msgid "Could not fetch usage, see the NVDA log"
msgstr "사용량을 가져올 수 없습니다. NVDA 로그를 확인하세요"

msgid "Unexpected response from ElevenLabs"
msgstr "ElevenLabs에서 예기치 않은 응답을 받았습니다"

msgid "Credits used: {used} of {limit} ({percent}%)."
msgstr "사용한 크레딧: {limit} 중 {used} ({percent}%)."

