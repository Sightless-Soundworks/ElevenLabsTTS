msgid "ElevenLabs is unavailable."
msgstr "ElevenLabs no ye disponible."

msgid "Could not find the ElevenLabs driver"
msgstr "No s'ha puesto trobar o controlador d'ElevenLabs"

msgid "No API key found"
msgstr "No s'ha trobau garra clau d'API"

msgid "Fetching usage"
msgstr "Obtenendo l'uso"

msgid "Could not fetch usage, see the NVDA log"
msgstr "No s'ha puesto obtener l'uso, veyer o rechistro de NVDA"

msgid "Unexpected response from ElevenLabs"
msgstr "Respuesta inasperada d'ElevenLabs"

msgid "Credits used: {used} of {limit} ({percent}%)."
msgstr "Creditos usaus: {used} de {limit} ({percent}%)."

